{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Imprint Customer Links Customer Sessions API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a new customer session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dev.sbx.imprint.co/v2/customer_sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new session for a customer with a client_secret that can be passed to the SDK, providing client access to modify their own profile, card, or card/loan application. If required, a new customer will be created to attach this session to. Customer history can be attached to this session and will be included in the customer's profile if created, or attached to the application the customer creates during the session"
        },
        {
          "info": {
            "name": "Retrieve a session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.sbx.imprint.co/v2/customer_sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a session"
        }
      ]
    }
  ],
  "bundled": true
}