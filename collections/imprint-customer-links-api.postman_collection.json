          "name": "Link an Imprint customer and partner customer accounts",
          "request": {
            "name": "Link an Imprint customer and partner customer accounts",
            "description": {
              "content": "Creates a link between an existing Imprint customer and a partner's customer account. The API key provided with the request will be used to link the partner with the imprint customer.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "customers",
                ":customer_id",
                "link"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customer_id",
                  "description": "(Required) The unique identifier for the Imprint customer"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
