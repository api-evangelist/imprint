{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Imprint Customer Links Orders API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.sbx.imprint.co/v2/orders",
            "params": [
              {
                "name": "id",
                "value": "77f60af4-185e-4867-b113-34e3cf7c6acd",
                "type": "query",
                "description": "An order ID. If provided, the response will only have a maximum of one result."
              },
              {
                "name": "partner_order_id",
                "value": "o-c8a1fe46bbff4a18ba1d",
                "type": "query",
                "description": "Partner's order identifier"
              }
            ]
          },
          "docs": "Get a list of orders"
        },
        {
          "info": {
            "name": "Create orders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dev.sbx.imprint.co/v2/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new orders"
        },
        {
          "info": {
            "name": "Modify order",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://dev.sbx.imprint.co/v2/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "77f60af4-185e-4867-b113-34e3cf7c6acd",
                "type": "path",
                "description": "Unique identifier for the order"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify an existing order"
        },
        {
          "info": {
            "name": "Delete order",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://dev.sbx.imprint.co/v2/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "77f60af4-185e-4867-b113-34e3cf7c6acd",
                "type": "path",
                "description": "Unique identifier for the order"
              }
            ]
          },
          "docs": "Delete an existing order"
        }
      ]
    }
  ],
  "bundled": true
